* text=auto
*.sh text eol=lf
*.py text eol=lf
*.yml text eol=lf
Makefile text eol=lf

# Preserve fixture bytes (PDF xref spacing and binary headers are significant).
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.bmp binary
*.ico binary
*.cur binary
*.tif binary
*.tiff binary
*.tga binary
*.pdf binary

# Inventory hashes are byte-exact, including SVG and license line endings.
assets/** -text
